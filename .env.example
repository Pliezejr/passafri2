# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

# --- Admin account -----------------------------------------------------
# If ADMIN_PASSWORD is left unset, the server generates a strong random
# password on first boot and prints it to the logs exactly once. Setting
# it explicitly here is recommended for production so you control it
# up front and it isn't sitting in your log history.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=

# --- Server --------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Set to 1 only if you are running behind a reverse proxy / load balancer
# that you trust to set X-Forwarded-Proto and X-Forwarded-For correctly
# (nginx, Caddy, Traefik, most PaaS platforms). This affects: whether
# session cookies get the Secure flag, whether rate limiting keys off the
# real client IP, and how X-Forwarded-* headers are trusted.
TRUST_PROXY=0

# Optional: pin the enterprise demo API key instead of letting the server
# generate a random one on first boot (useful for reproducible demos/tests).
# DEMO_API_KEY=

# Optional: redirect both data/ and uploads/ under one mounted volume —
# useful on platforms that only give you a single persistent disk per
# service (Render, Fly.io). Leave unset for local/Docker Compose use.
# STORAGE_DIR=/var/data/afripass
